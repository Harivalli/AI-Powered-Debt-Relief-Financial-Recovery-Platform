# Rename this file to .env and fill in real values

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./finrelief.db

# Google Gemini - leave blank to run in offline/demo mode with placeholder AI responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS - comma separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
